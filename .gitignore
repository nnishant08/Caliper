.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Generated by XcodeGen — regenerate with Scripts/bootstrap.sh
Caliper.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Data pipeline: raw dumps and build outputs never enter the repo.
# The OFF dump alone is tens of GB, and the emitted snapshot ships from
# object storage, not from git.
tools/snapshot/.venv/
tools/snapshot/data/
tools/snapshot/out/
__pycache__/
*.pyc

# Secrets — no API keys or signing material in the repo.
*.p8
*.p12
*.mobileprovision
.env
